# Data lives in DVC, never in Git (dvc.yaml / dvc.lock are committed instead)
/data/*
!/data/.gitkeep
# Outputs of sample runs (--sample-size / DAG param sample_size): never committed or versioned
/data/sample/

# Logs (Airflow task logs, pipeline.log, alerts.log)
/logs/*
!/logs/.gitkeep

# Reports from sample runs (--sample-size); full-run reports in reports/ are committed
/reports/sample/

# Secrets and local environments
.env
.env.*
!.env.example
.venv/
.cache/

# Python / tooling
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage*
coverage.xml
htmlcov/
