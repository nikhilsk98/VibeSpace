# Copy to .env and fill in. Never commit .env.

# TMDB: v3 API key (32 characters) or v4 read access token (starts with "eyJ")
TMDB_API_KEY=

# Which movies to fetch from TMDB: genome | rest | all
TMDB_STAGE=genome
# Optional: run on N movies only (empty = all)
SAMPLE_SIZE=
TMDB_MAX_WORKERS=8
TMDB_RATE_LIMIT=20
MIN_MATCH_RATE=0.90

# Alerts (all optional; without them alerts go to logs/alerts.log)
SLACK_WEBHOOK_URL=
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_USE_TLS=true

# Docker: your user id, so files that Airflow writes belong to you (run: id -u)
AIRFLOW_UID=50000
# Airflow web UI login (set up when you run `docker compose up airflow-init`)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Optional cron schedule for the optimised DAG (empty = manual trigger only)
VIBESPACE_SCHEDULE=
